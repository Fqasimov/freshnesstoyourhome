# Node
node_modules/
dist/
dist-single/
dist-admin-demo/

# Laravel
/backend/vendor/
/backend/.env
/backend/.env.backup
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/public/storage
/backend/.phpunit.result.cache
/backend/database/*.sqlite

# Capacitor native projects are generated; the config is what we keep.
/app/ios/
/app/android/
/app/dist/

# Secrets — never commit any of these
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

.DS_Store

# The product photo library lives in shared/products and is copied into both
# bundles by `npm run sync`. The copies are build output; committing them would
# put the same six megabytes in the repository three times over.
/web/src/assets/products/*.jpg
/app/assets/products/*.jpg

# Upload packages built by scripts/package-deploy.sh — build output, and the
# backend one carries the installer's one-time URL.
/deploy-out/

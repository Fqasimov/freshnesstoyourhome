# Where the catalogue and basket pricing come from.
#
# Leave this unset for a purely static build: the site then renders the
# catalogue bundled into src/data/catalogue.js, which is a valid way to deploy
# the marketing site on its own.
#
# Set it and the site reads live prices from the API instead, so a price change
# is a row update rather than a redeploy — and the basket total handed to
# WhatsApp is computed by the server rather than by the browser.
VITE_API_URL=http://localhost:8000

# Google Maps. Enables "pick on the map" in the basket: a map with a pin to tap
# or drag. Without it the basket still offers "use my location", which needs no
# key. This is a browser key by design, so restrict it in Google Cloud to
# HTTP referrers freshnesstoyourhome.az/* and to the Maps JavaScript API only.
# On the deploy, set it as the repository variable GOOGLE_MAPS_KEY.
VITE_GOOGLE_MAPS_KEY=

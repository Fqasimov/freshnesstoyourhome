{
  "name": "freshness-to-your-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Product catalogue and ordering site for Freshness To Your Home, Baku",
  "scripts": {
    "sync": "node ../scripts/sync.mjs",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "vite build",
    "postbuild": "node scripts/place-cms.mjs",
    "preview": "vite preview",
    "prebuild:single": "npm run sync",
    "build:single": "vite build --mode single",
    "build:admin-demo": "VITE_ADMIN_DEMO=1 vite build --mode admin-demo",
    "check": "node ../scripts/check.mjs",
    "pretest:api": "npm run check",
    "test:api": "node tests/api-integration.mjs"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "playwright": "^1.63.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}

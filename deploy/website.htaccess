# Freshness To Your Home — website (public_html/.htaccess)
#
# Serves the built shop and the /cms panel. The API has its own rules in
# public_html/server/.htaccess; a child folder with RewriteEngine On does not
# inherit the rewrite rules below, so both files carry the deny list.

Options -Indexes -MultiViews
AddType application/manifest+json .webmanifest

# Addresses that do not exist get a real 404, with a page that helps.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address for the shop: www and the old domain go to freshness.az —
  # first, before the HTTPS rule, so http://old-domain/x is one redirect, not two.
  # The API (/server) is left alone on purpose: app builds already on phones
  # call the old domain's /server, and a redirect would turn their POSTs into
  # GETs or drop their sign-in. /.well-known stays for certificate renewal.
  RewriteCond %{HTTP_HOST} ^(www\.freshness\.az|(www\.)?freshnesstoyourhome\.az)$ [NC]
  RewriteCond %{REQUEST_URI} !^/(server|\.well-known)(/|$)
  RewriteRule ^ https://freshness.az%{REQUEST_URI} [R=301,L]

  # HTTPS only. /.well-known stays reachable over plain HTTP, because that is
  # where AutoSSL proves the domain is ours when it renews the certificate.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Dotfiles — .env, .git, .htaccess, .DS_Store — are never served.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Nothing from a code checkout belongs on a website, even by accident.
  RewriteRule (^|/)(vendor|node_modules|storage|bootstrap|database|tests)(/|$) - [F,L,NC]
  RewriteRule (^|/)(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$ - [F,L,NC]
  RewriteRule \.(env|ini|log|sql|sqlite|bak|old|orig|swp|dist|sh|ya?ml|zip|tar|t?gz|7z|rar|map)$ - [F,L,NC]

  # One address per page. /kataloq/ and /index.html are the same pages as
  # /kataloq and /, so they move there for good — Google otherwise counts
  # two. Real folders (/privacy/, /cms/) keep their slash: Apache needs it
  # to serve the index inside.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{REQUEST_URI} !^/(server|cms|privacy|delete-account|\.well-known)(/|$)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Products and categories that moved to a new address in the panel: the
  # old one leads to the new for good. Filled in by web/scripts/prerender.mjs at deploy time.
  # @product-redirects
  # @end-product-redirects

  # Pages the build wrote as plain HTML, with their own title and structured
  # data for search engines (web/scripts/prerender.mjs). The app takes over
  # once it starts. Russian and English live under /ru and /en.
  # They live under /pages, not in a folder called kataloq or ru: a real
  # folder by that name would make Apache add a slash before these rules.
  RewriteCond %{QUERY_STRING} (^|&)q=
  RewriteRule ^((ru|en)/)?kataloq(/.*)?$ - [E=FTH_NOINDEX:1]
  RewriteRule ^kataloq$ pages/kataloq.html [L]
  RewriteCond %{DOCUMENT_ROOT}/pages/kataloq/$1.html -f
  RewriteRule ^kataloq/([a-z0-9-]+)$ pages/kataloq/$1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/mehsul/$1.html -f
  RewriteRule ^mehsul/([a-z0-9-]+)$ mehsul/$1.html [L]
  RewriteRule ^(ru|en)/kataloq$ pages/$1/kataloq.html [L]
  RewriteCond %{DOCUMENT_ROOT}/pages/$1/kataloq/$2.html -f
  RewriteRule ^(ru|en)/kataloq/([a-z0-9-]+)$ pages/$1/kataloq/$2.html [L]
  RewriteCond %{DOCUMENT_ROOT}/pages/$1/mehsul/$2.html -f
  RewriteRule ^(ru|en)/mehsul/([a-z0-9-]+)$ pages/$1/mehsul/$2.html [L]

  # Recipes: the list and one page each, in each language.
  RewriteCond %{DOCUMENT_ROOT}/pages/resept.html -f
  RewriteRule ^resept$ pages/resept.html [L]
  RewriteCond %{DOCUMENT_ROOT}/pages/resept/$1.html -f
  RewriteRule ^resept/([a-z0-9-]+)$ pages/resept/$1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/pages/$1/resept.html -f
  RewriteRule ^(ru|en)/resept$ pages/$1/resept.html [L]
  RewriteCond %{DOCUMENT_ROOT}/pages/$1/resept/$2.html -f
  RewriteRule ^(ru|en)/resept/([a-z0-9-]+)$ pages/$1/resept/$2.html [L]

  # The home pages, and the app's other pages.
  RewriteRule ^(hesab)?$ index.html [L]
  RewriteRule ^(ru|en)(/hesab)?$ pages/$1/index.html [L]

  # Everything else does not exist: a 404, answered by 404.html (below). It
  # is the app's own page, so a product or category added in the panel since
  # the last build still opens for a visitor — only Google is told it is not
  # there yet, until the nightly build writes its page. The API, the panel,
  # the privacy page and real files never reach this line.
  RewriteCond %{REQUEST_URI} !^/(server|cms|privacy|\.well-known)(/|$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]

  # The site is static: no PHP runs outside the API folder.
  RewriteCond %{REQUEST_URI} !^/server/
  RewriteRule \.(php[0-9]?|phtml|phar|pht)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  # Hashed files under /assets never change once published, so browsers may
  # keep them for a year. The HTML must be re-checked on every visit, or a
  # customer keeps seeing yesterday's shop after a redeploy.
  <FilesMatch "\.(js|css|jpg|jpeg|png|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # A search inside the catalogue (/kataloq?q=...) is not a page of its own.
  # The flag is set by the rewrite rules above; after their internal rewrite
  # Apache renames it REDIRECT_FTH_NOINDEX, so both names are checked.
  Header set X-Robots-Tag "noindex, follow" env=FTH_NOINDEX
  Header set X-Robots-Tag "noindex, follow" env=REDIRECT_FTH_NOINDEX

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"

    # Google Maps is NOT allowed here. The basket's "pick on the map" pin needs
    # it, so scripts/package-deploy.sh adds exactly maps.googleapis.com and
    # maps.gstatic.com to this policy — and only when a Maps key is configured
    # (GOOGLE_MAPS_KEY). Without a key the policy below ships unchanged.
    #
    # Only our own scripts run, from our own origin: no inline script, no
    # eval, nothing from another site. This is what keeps an injected string
    # from becoming code — and with it the panel's session token. Styles
    # allow 'unsafe-inline' because Vue writes style attributes; a style
    # cannot read a token. Fonts come from Google. HTML only, so it never
    # overrides the stricter policy the API sets on its own responses.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Browsers remember "HTTPS only" for a year. Sent only over HTTPS, and
  # without includeSubDomains, so cPanel's own subdomains are not caught up.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

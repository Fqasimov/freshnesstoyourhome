# Freshness To Your Home — website (public_html/.htaccess)
#
# Hashed files under /assets never change once published, so browsers may keep
# them for a year. The HTML pages must be re-checked on every visit, or a
# customer keeps seeing yesterday's shop after a redeploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes

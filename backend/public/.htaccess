# The API's front door (public_html/server/ on cPanel; backend/public elsewhere).

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS only, as for the site itself: this folder is not covered by the
    # site's own rules, and a token or a code sent over http is readable on
    # the way. /.well-known stays reachable for certificate renewal.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_URI} !/\.well-known/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Dotfiles (.env, .git, .htaccess) are never served.
    RewriteRule (^|/)\. - [F,L]

    # Only Laravel's own index.php — and the one-time installer or upgrade
    # script, whose names are 24 random hex characters — may run as PHP here.
    # Anything else ending in .php is refused before PHP ever sees it.
    RewriteCond %{REQUEST_URI} !/(index|install-[0-9a-f]{24}|upgrade-[0-9a-f]{24})\.php$
    RewriteRule \.(php[0-9]?|phtml|phar|pht|phps)$ - [F,L,NC]

    # storage/ is where uploaded photographs are served from. Photographs
    # only: whatever else might ever land there is refused, not run.
    RewriteCond %{REQUEST_URI} !\.(jpe?g|png|webp)$ [NC]
    RewriteRule ^storage/ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

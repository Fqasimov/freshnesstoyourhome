# Freshness To Your Home — API configuration
#
# Copy to .env and fill in. Nothing in this file is a secret; nothing in .env
# ever belongs in git. On a production host, prefer the platform's secret
# store over a file on disk.

APP_NAME="Freshness To Your Home"
APP_ENV=local

# php artisan key:generate
# Encrypts every personal-data column. If this is lost or changed, every
# customer name, address, phone and email becomes permanently unreadable.
# Back it up before the first order is taken.
APP_KEY=

# MUST be false in production. True exposes stack traces, environment
# variables and SQL to anyone who can trigger an error.
APP_DEBUG=true

APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Baku

# Azerbaijani is the shop's language and the app's default. Clients state the
# language they are displaying on each request; this is the fallback.
APP_LOCALE=az

# php artisan freshness:generate-keys
# Keyed hash that makes encrypted columns searchable. Must differ from APP_KEY.
# Changing it makes every existing customer unfindable by email.
BLIND_INDEX_KEY=

# The only addresses allowed into the admin panel (/cms, or /admin.html in
# development). Comma-separated. Empty means nobody.
ADMIN_EMAILS=

# --- Database -------------------------------------------------------------
# Postgres, reachable privately. This database should not be addressable from
# the public internet: the API is the only thing that talks to it.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=freshness
DB_USERNAME=freshness
DB_PASSWORD=

# --- Mail (Resend) --------------------------------------------------------
# Sign-in codes go out over this, and they are the ONLY way into the app. If
# mail stops working, nobody can log in — this is the front door, not a
# peripheral integration.
#
# Deliverability is the whole job here. Verify the sending domain in Resend and
# publish its SPF, DKIM and DMARC records before launch: a code in a spam
# folder is a customer who cannot sign in.
#
# MAIL_FROM_ADDRESS must be on a domain verified in Resend. Resend will refuse
# to send from an unverified one.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@freshnesstoyourhome.az"
MAIL_FROM_NAME="${APP_NAME}"

# In local development use `log` instead and read the code out of
# storage/logs/laravel.log — or just run `php artisan freshness:dev-user`,
# which prints one directly.
# MAIL_MAILER=log

# --- Queue and cache ------------------------------------------------------
# Sign-in emails are queued so the request does not wait on the mail server.
# A worker must be running, or nobody can sign in: php artisan queue:work
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# --- Business rules -------------------------------------------------------
ORDER_LEAD_DAYS=1
DELIVERY_OPEN=10:00
DELIVERY_CLOSE=22:00

# How far a weighed line may move from its estimate before the customer has to
# be asked. Shown in the app as "about X, at most Y".
WEIGHT_TOLERANCE_PERCENT=10

# --- Abuse limits ---------------------------------------------------------
# Sign-in codes cost nothing to request and something to send. The global cap
# is the backstop for an attacker with many addresses and many IPs; if it
# trips, treat it as an incident.
OTP_PER_EMAIL_HOURLY=5
OTP_PER_IP_HOURLY=15
OTP_GLOBAL_HOURLY=500

# --- Deployment -----------------------------------------------------------
# Behind a load balancer, the real client IP arrives in a header. Without this
# every rate limit counts the proxy as a single client.
TRUSTED_PROXIES=*

SUPPORT_PHONE="+994503521919"
SUPPORT_WHATSAPP="994503521919"
SUPPORT_INSTAGRAM="freshness_to_your_home"

LOG_CHANNEL=stack
LOG_LEVEL=debug

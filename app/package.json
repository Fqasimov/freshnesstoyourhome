  "scripts": {
    "sync": "node ../scripts/sync.mjs",
    "prestart": "npm run sync",
    "start": "expo start",
    "prestart:live": "npm run sync",
    "start:live": "node ../scripts/start-live.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "node ../scripts/check.mjs",
    "pretypecheck": "npm run sync",
    "typecheck": "tsc --noEmit",
    "preexport:web": "npm run sync",
    "export:web": "expo export --platform web",
    "journey": "expo export --platform web && node tests/journey.mjs",
    "prejourney:only": "npm run check",
    "journey:only": "node tests/journey.mjs",
    "eas-build-post-install": "npm run sync"

# The API this build talks to. There is deliberately no default: a build that
# forgets this should fail at startup rather than quietly point somewhere wrong
# and appear to work during App Store review.
#
#   development : http://localhost:8000   (or your machine's LAN IP for a device)
#   production  : https://api.freshnesstoyourhome.az
#
# Must be https in any build that leaves your machine. Both platforms block
# cleartext HTTP by default, and a sign-in token over http is a token anyone on
# the same wifi can read.
VITE_API_URL=https://api.freshnesstoyourhome.az

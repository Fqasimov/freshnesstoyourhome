# The API this build talks to.
#
# There is deliberately no default in the code: a build that forgets this
# should fail at startup rather than quietly point somewhere wrong and appear
# to work all the way through App Store review.
#
# For Expo Go on a phone, this must be your machine's LAN address — not
# localhost, which on the phone means the phone itself:
#   EXPO_PUBLIC_API_URL=http://192.168.1.14:8000
#
# Real builds get this from eas.json instead, per profile.
EXPO_PUBLIC_API_URL=http://localhost:8000

{
  "appId": "az.freshnesstoyourhome.app",
  "appName": "Freshness To Your Home",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#3A6A2C",
      "androidScaleType": "CENTER_CROP"
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
